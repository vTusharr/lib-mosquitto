LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_LIB)/will_mosq.c
# Skipped: net_mosq_ocsp.c, net_ws.c, http_client.c (need WITH_TLS)

# common files
LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_COMMON)/json_help.c

# plugin files 
LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_PLUGINS)/acl-file/acl_check.c
LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_PLUGINS)/acl-file/acl_parse.c
LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_PLUGINS)/password-file/password_check.c
LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_PLUGINS)/password-file/password_parse.c

# Libcommon files
LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_LIBCOMMON)/base64_common.c
LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_LIBCOMMON)/cjson_common.c
LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_LIBCOMMON)/file_common.c
LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_LIBCOMMON)/memory_common.c
LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_LIBCOMMON)/mqtt_common.c
