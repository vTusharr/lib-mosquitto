LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_SRC)/retain.c
LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_SRC)/security_default.c
LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_SRC)/send_auth.c
LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_SRC)/send_connack.c
LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_SRC)/send_suback.c
LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_SRC)/send_unsuback.c
LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_SRC)/session_expiry.c
LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_SRC)/signals.c
LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_SRC)/subs.c
LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_SRC)/sys_tree.c
LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_SRC)/topic_tok.c
LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_SRC)/watchdog.c
LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_SRC)/will_delay.c
# Skipped: service.c (Win service), http_api.c (requires libmicrohttpd),
#          xtreport.c (optional debug), mux_kqueue.c (bsd only),
#          websockets.c/http_serv.c (need WITH_WEBSOCKETS; 2.1's built-in
#          backend drops the libwebsockets dependency but requires openssl,see lib/net_ws.c)

################################################################################
# external source files (from lib/, common/, plugins/)
################################################################################
LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_LIB)/alias_mosq.c
LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_LIB)/handle_ping.c
LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_LIB)/handle_pubackcomp.c
LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_LIB)/handle_pubrec.c
LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_LIB)/handle_pubrel.c
