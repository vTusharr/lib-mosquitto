LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_LIB)/handle_unsuback.c
LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_LIB)/net_mosq.c
LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_LIB)/packet_datatypes.c
LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_LIB)/packet_mosq.c
LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_LIB)/property_mosq.c
LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_LIB)/send_connect.c
LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_LIB)/send_disconnect.c
LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_LIB)/send_mosq.c
