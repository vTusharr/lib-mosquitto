################################################################################
# library registration
################################################################################
$(eval $(call addlib_s,libmosquitto,$(CONFIG_LIBMOSQUITTO)))

################################################################################
# sources
################################################################################
LIBMOSQUITTO_VERSION = 2.1.2
LIBMOSQUITTO_BASENAME = mosquitto-$(LIBMOSQUITTO_VERSION)
LIBMOSQUITTO_URL = https://mosquitto.org/files/source/$(LIBMOSQUITTO_BASENAME).tar.gz
$(eval $(call fetch,libmosquitto,$(LIBMOSQUITTO_URL)))

################################################################################
# cjson dependency
################################################################################
LIBMOSQUITTO_CJSON_VERSION = 1.7.18
LIBMOSQUITTO_CJSON_BASENAME = cJSON-$(LIBMOSQUITTO_CJSON_VERSION)
LIBMOSQUITTO_CJSON_URL = https://github.com/DaveGamble/cJSON/archive/refs/tags/v$(LIBMOSQUITTO_CJSON_VERSION).tar.gz
$(eval $(call fetch,libmosquitto_cjson,$(LIBMOSQUITTO_CJSON_URL)))
LIBMOSQUITTO_CJSON_SRC = $(LIBMOSQUITTO_CJSON_ORIGIN)/$(LIBMOSQUITTO_CJSON_BASENAME)

################################################################################
# Helpers
################################################################################
LIBMOSQUITTO_SRC = $(LIBMOSQUITTO_ORIGIN)/$(LIBMOSQUITTO_BASENAME)/src
LIBMOSQUITTO_LIB = $(LIBMOSQUITTO_ORIGIN)/$(LIBMOSQUITTO_BASENAME)/lib
LIBMOSQUITTO_LIBCOMMON = $(LIBMOSQUITTO_ORIGIN)/$(LIBMOSQUITTO_BASENAME)/libcommon
LIBMOSQUITTO_COMMON = $(LIBMOSQUITTO_ORIGIN)/$(LIBMOSQUITTO_BASENAME)/common
LIBMOSQUITTO_PLUGINS = $(LIBMOSQUITTO_ORIGIN)/$(LIBMOSQUITTO_BASENAME)/plugins
LIBMOSQUITTO_DEPS = $(LIBMOSQUITTO_ORIGIN)/$(LIBMOSQUITTO_BASENAME)/deps
LIBMOSQUITTO_INCLUDE = $(LIBMOSQUITTO_ORIGIN)/$(LIBMOSQUITTO_BASENAME)/include

################################################################################
# Library includes
################################################################################
# Mosquitto source root must come first so its native config.h is found
LIBMOSQUITTO_CINCLUDES-y += -I$(LIBMOSQUITTO_ORIGIN)/$(LIBMOSQUITTO_BASENAME)
LIBMOSQUITTO_CINCLUDES-y += -I$(LIBMOSQUITTO_SRC)
LIBMOSQUITTO_CINCLUDES-y += -I$(LIBMOSQUITTO_LIB)
LIBMOSQUITTO_CINCLUDES-y += -I$(LIBMOSQUITTO_COMMON)
LIBMOSQUITTO_CINCLUDES-y += -I$(LIBMOSQUITTO_LIBCOMMON)
LIBMOSQUITTO_CINCLUDES-y += -I$(LIBMOSQUITTO_INCLUDE)
LIBMOSQUITTO_CINCLUDES-y += -I$(LIBMOSQUITTO_DEPS)
LIBMOSQUITTO_CINCLUDES-y += -I$(LIBMOSQUITTO_PLUGINS)/acl-file
LIBMOSQUITTO_CINCLUDES-y += -I$(LIBMOSQUITTO_PLUGINS)/password-file
LIBMOSQUITTO_CINCLUDES-y += -I$(LIBMOSQUITTO_CJSON_ORIGIN)
# <sys/syslog.h> compatibility header, see include/sys/syslog.h
LIBMOSQUITTO_CINCLUDES-y += -I$(LIBMOSQUITTO_BASE)/include

################################################################################
# Prepare symlink so <cjson/cJSON.h> resolves
################################################################################
$(LIBMOSQUITTO_CJSON_ORIGIN)/cjson: $(LIBMOSQUITTO_CJSON_SRC)/cJSON.h
	ln -sfn $(LIBMOSQUITTO_CJSON_SRC) $(LIBMOSQUITTO_CJSON_ORIGIN)/cjson

UK_PREPARE += $(LIBMOSQUITTO_CJSON_ORIGIN)/cjson

################################################################################
# Flags
################################################################################
# -DWITH_BROKER is the key flag that tells Mosquitto code we are building the broker
LIBMOSQUITTO_CFLAGS-y += -DWITH_BROKER
LIBMOSQUITTO_CFLAGS-y += -DWITH_PERSISTENCE
LIBMOSQUITTO_CFLAGS-y += -DWITH_MEMORY_TRACKING
LIBMOSQUITTO_CFLAGS-y += -DWITH_SYS_TREE
LIBMOSQUITTO_CFLAGS-y += -DWITH_CONTROL
LIBMOSQUITTO_CFLAGS-y += -DWITH_BRIDGE
LIBMOSQUITTO_CFLAGS-y += -DWITH_BUNDLED_DEPS
LIBMOSQUITTO_CFLAGS-y += -DWITH_THREADING
LIBMOSQUITTO_CFLAGS-y += -DWITH_CJSON
LIBMOSQUITTO_CFLAGS-y += -DWITH_EPOLL
LIBMOSQUITTO_CFLAGS-y += -DHAVE_GETRANDOM
LIBMOSQUITTO_CFLAGS-y += -DVERSION="\"$(LIBMOSQUITTO_VERSION)\""

# Suppress warnings for neater build
LIBMOSQUITTO_CFLAGS-y += -Wno-unused-parameter
LIBMOSQUITTO_CFLAGS-y += -Wno-unused-variable
LIBMOSQUITTO_CFLAGS-y += -Wno-unused-but-set-variable
LIBMOSQUITTO_CFLAGS-y += -Wno-sign-compare

# Rename main to mosquitto_main so we can wrap it
LIBMOSQUITTO_MOSQUITTO_FLAGS-y += -Dmain=mosquitto_main
LIBMOSQUITTO_RANDOM_COMMON_FLAGS-y += -include sys/random.h

################################################################################
# Main wrapper
################################################################################
LIBMOSQUITTO_SRCS-$(CONFIG_LIBMOSQUITTO_MAIN_FUNCTION) += $(LIBMOSQUITTO_BASE)/main.c|unikraft

################################################################################
# Broker source files (from src/)
################################################################################
LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_SRC)/mosquitto.c
LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_SRC)/acl_file.c
LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_SRC)/bridge.c
LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_SRC)/bridge_topic.c
LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_SRC)/broker_control.c
LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_SRC)/conf.c
LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_SRC)/conf_includedir.c
LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_SRC)/context.c
LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_SRC)/control.c
LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_SRC)/control_common.c
LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_SRC)/database.c
LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_SRC)/handle_auth.c
LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_SRC)/handle_connack.c
LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_SRC)/handle_connect.c
LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_SRC)/handle_disconnect.c
LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_SRC)/handle_publish.c
LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_SRC)/handle_subscribe.c
LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_SRC)/handle_unsubscribe.c
LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_SRC)/keepalive.c
LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_SRC)/listeners.c
LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_SRC)/logging.c
LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_SRC)/loop.c
LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_SRC)/mux.c
LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_SRC)/mux_epoll.c
LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_SRC)/mux_poll.c
LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_SRC)/net.c
LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_SRC)/password_file.c
LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_SRC)/persist_read.c
LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_SRC)/persist_read_v234.c
LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_SRC)/persist_read_v5.c
LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_SRC)/persist_write.c
LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_SRC)/persist_write_v5.c
LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_SRC)/plugin_callbacks.c
LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_SRC)/plugin_v2.c
LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_SRC)/plugin_v3.c
LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_SRC)/plugin_v4.c
LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_SRC)/plugin_v5.c
LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_SRC)/plugin_acl_check.c
LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_SRC)/plugin_basic_auth.c
LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_SRC)/plugin_cleanup.c
LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_SRC)/plugin_client_offline.c
LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_SRC)/plugin_connect.c
LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_SRC)/plugin_disconnect.c
LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_SRC)/plugin_extended_auth.c
LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_SRC)/plugin_init.c
LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_SRC)/plugin_message.c
LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_SRC)/plugin_persist.c
LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_SRC)/plugin_psk_key.c
LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_SRC)/plugin_public.c
LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_SRC)/plugin_reload.c
LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_SRC)/plugin_subscribe.c
LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_SRC)/plugin_tick.c
LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_SRC)/plugin_unsubscribe.c
LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_SRC)/property_broker.c
LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_SRC)/proxy_v1.c
LIBMOSQUITTO_SRCS-y += $(LIBMOSQUITTO_SRC)/proxy_v2.c
